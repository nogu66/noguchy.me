---
import { PUBLIC_GOOGLE_ANALYTICS_ID } from "astro:env/client";
import { SITE } from "@/config";
import ThemeScript from "@/components/ThemeScript.astro";
import "@/styles/global.css";

// プロフィール情報
const profile = {
  name: "nogu",
  title: "Software Engineer",
  bio: "デジタルデータに関するシステム開発、AIエージェント開発・生成AI推進に取り組む。また、個人として、生成AI活用ノウハウの発信を行う。",
  avatar: "/profile.png",
};

// リンク一覧（セクションごと、上から新しい順）
type LinkItem = {
  url: string;
  title: string;
  description?: string;
  meta?: string;
  // OGP 画像の代わりに使うサムネイル
  image?: string;
  // 正方形のアバターなど、切り抜かずに全体を見せたい画像
  imageFit?: "contain";
};

const sections: {
  label: string;
  // card: 画像を大きく見せるカード / row: サムネ付きの行（デフォルト）
  layout?: "card" | "row";
  items: LinkItem[];
}[] = [
  {
    label: "Site & Writing",
    layout: "card",
    items: [
      {
        url: "https://noguchy.me/",
        title: "noguchy.me",
        description: "個人サイト。ブログ・登壇・ニュース",
        image: "/ogp.png",
      },
      {
        url: "https://zenn.dev/nogu66",
        title: "Zenn",
        imageFit: "contain",
        description: "技術記事",
      },
      {
        url: "https://github.com/nogu66",
        title: "GitHub",
      },
    ],
  },
  {
    label: "OSS",
    layout: "card",
    items: [
      {
        url: "https://github.com/nogu66/calmpage",
        title: "calmpage",
        description:
          "静かな macOS 向け LaTeX エディタ。左で書いて右で PDF。Claude Code / Codex の AI パネル付き",
        meta: "macOS · LaTeX",
      },
      {
        url: "https://github.com/nogu66/md-prompt",
        title: "md-prompt",
        description:
          "Claude Code のプロンプト入力欄を Markdown でリアルタイム描画",
        meta: "Claude Code",
      },
    ],
  },
  {
    label: "Tools",
    items: [
      {
        url: "https://qr.shuhary.com/",
        title: "2D Code Maker",
        description: "二次元コードをブラウザで作成",
      },
    ],
  },
];

// OGPのHTMLエンティティをデコードする関数
function decodeEntities(text: string) {
  return text
    .replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
    .replace(/&#x([0-9a-f]+);/gi, (_, code) =>
      String.fromCodePoint(parseInt(code, 16))
    )
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&");
}

// OGP画像を取得する関数（タイトルと説明は sections に手書き）
async function fetchOgpImage(url: string) {
  // GitHubユーザーページの場合は草グラフを使用
  const githubUserMatch = url.match(/^https?:\/\/github\.com\/([^\/]+)\/?$/);
  if (githubUserMatch) {
    return {
      image: `https://ghchart.rshah.org/${githubUserMatch[1]}`,
      isGithubChart: true,
    };
  }

  try {
    const response = await fetch(url, {
      headers: {
        "User-Agent": "Mozilla/5.0 (compatible; OGP Fetcher)",
      },
    });
    const html = await response.text();
    const match = html.match(
      /<meta[^>]*property=["']og:image["'][^>]*content=["']([^"']*)["']|<meta[^>]*content=["']([^"']*)["'][^>]*property=["']og:image["']/i
    );
    const image = match ? match[1] || match[2] : null;
    return {
      image: image ? decodeEntities(image) : null,
      isGithubChart: false,
    };
  } catch {
    return { image: null, isGithubChart: false };
  }
}

// ビルド時にOGP画像を取得
const linkSections = await Promise.all(
  sections.map(async section => ({
    label: section.label,
    layout: section.layout ?? "row",
    items: await Promise.all(
      section.items.map(async item => ({
        ...item,
        meta: item.meta ?? new URL(item.url).hostname,
        ...(item.image
          ? { image: item.image, isGithubChart: false }
          : await fetchOgpImage(item.url)),
      }))
    ),
  }))
);

const pageTitle = `${profile.name} | Links`;
const pageDesc = profile.bio;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={`${SITE.website}ogp.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE.website}links`} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@600;700;900&family=Roboto:wght@600;700;900&display=swap"
    />
    <ThemeScript />

    {
      // Google Analytics 4
      PUBLIC_GOOGLE_ANALYTICS_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${PUBLIC_GOOGLE_ANALYTICS_ID}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${PUBLIC_GOOGLE_ANALYTICS_ID}');`}
          />
        </>
      )
    }

    {
      // Google Analytics - View Transitions support
      PUBLIC_GOOGLE_ANALYTICS_ID && (
        <script
          is:inline
          set:html={`document.addEventListener("astro:page-load", () => { if (typeof gtag === "function" && "${PUBLIC_GOOGLE_ANALYTICS_ID}") { gtag("config", "${PUBLIC_GOOGLE_ANALYTICS_ID}", { page_path: window.location.pathname }); } });`}
        />
      )
    }
  </head>
  <body
    class="flex min-h-screen flex-col items-center justify-center bg-background px-4 py-12"
  >
    <div class="w-full max-w-2xl">
      <!-- プロフィール -->
      <div class="mb-8 flex flex-col items-center text-center">
        <div
          class="mb-4 h-24 w-24 overflow-hidden rounded-full border-2 border-cobalt bg-surface-soft"
        >
          {
            profile.avatar ? (
              <img
                src={profile.avatar}
                alt={profile.name}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center text-3xl font-black text-cobalt">
                {profile.name.charAt(0).toUpperCase()}
              </div>
            )
          }
        </div>
        <h1 class="text-[33.28px] leading-none">
          {profile.name}<span class="text-cobalt">.</span>
        </h1>
        {
          profile.title && (
            <p class="cw-label mt-2 text-ink-muted">{profile.title}</p>
          )
        }
        {
          profile.bio && (
            <p class="mt-4 text-sm text-ink-muted">{profile.bio}</p>
          )
        }
      </div>

      <!-- Link sections -->
      <div class="flex flex-col gap-10">
        {
          linkSections.map(section => (
            <section class="w-full px-0">
              <h2 class="cw-label mb-3 flex items-center gap-2 text-ink-muted">
                <span class="text-cobalt">{section.label}</span>
                <span class="h-0.5 flex-1 bg-line" />
                <span>{section.items.length}</span>
              </h2>
              {section.layout === "card" ? (
                <ul class="grid gap-4 sm:grid-cols-2">
                  {section.items.map(link => (
                    <li class:list={[link.isGithubChart && "sm:col-span-2"]}>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cw-card"
                      >
                        {link.image &&
                          (link.isGithubChart ? (
                            <div class="border-b-2 border-ink bg-white p-4 sm:p-6">
                              <img
                                src={link.image}
                                alt={`${link.title} contributions`}
                                class="h-auto w-full"
                                loading="lazy"
                              />
                            </div>
                          ) : (
                            <div class="aspect-[1.91/1] w-full overflow-hidden border-b-2 border-ink bg-surface-soft">
                              <img
                                src={link.image}
                                alt=""
                                class:list={[
                                  "h-full w-full",
                                  link.imageFit === "contain"
                                    ? "object-contain p-4"
                                    : "object-cover",
                                ]}
                                loading="lazy"
                              />
                            </div>
                          ))}
                        <div class="flex flex-1 flex-col p-4">
                          <div class="flex flex-wrap items-baseline justify-between gap-x-2">
                            <span class="text-lg font-black">{link.title}</span>
                            <span class="cw-ui shrink-0 text-ink-muted">
                              {link.meta}
                            </span>
                          </div>
                          {link.description && (
                            <p class="mt-1 text-sm text-ink-muted">
                              {link.description}
                            </p>
                          )}
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="flex flex-col gap-3">
                  {section.items.map(link => (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cw-card h-auto!"
                      >
                        <div class="flex items-center gap-4 p-4">
                          {link.image && !link.isGithubChart && (
                            <div class="aspect-[1.91/1] w-28 shrink-0 overflow-hidden border-2 border-ink bg-surface-soft sm:w-36">
                              <img
                                src={link.image}
                                alt=""
                                class="h-full w-full object-cover"
                                loading="lazy"
                              />
                            </div>
                          )}
                          <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-2">
                              <span class="text-lg font-black">
                                {link.title}
                              </span>
                              <span class="cw-ui shrink-0 text-ink-muted">
                                {link.meta}
                              </span>
                            </div>
                            {link.description && (
                              <p class="mt-1 line-clamp-2 text-sm text-ink-muted">
                                {link.description}
                              </p>
                            )}
                          </div>
                        </div>
                        {link.image && link.isGithubChart && (
                          <div class="border-t-2 border-ink bg-white p-4">
                            <img
                              src={link.image}
                              alt={`${link.title} contributions`}
                              class="h-auto w-full"
                              loading="lazy"
                            />
                          </div>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <!-- テーマ切り替え -->
      <div class="mt-8 flex justify-center">
        <button
          id="theme-btn"
          class="rounded-full border-2 border-cobalt p-2 text-cobalt hover:bg-cobalt hover:text-on-cobalt"
          title="テーマ切り替え"
          aria-label="テーマ切り替え"
        >
          <svg
            id="sun-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5 dark:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            id="moon-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="block h-5 w-5 dark:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </body>
</html>
