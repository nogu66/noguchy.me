                          <span
                            set:html={md(r.can.replace(/^観察のみ。?/, " "))}
                          />
                        </span>
                      ) : (
                        <span set:html={md(r.can)} />
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="api" class="cw-section px-0">
      <h2 class="cw-heading">$ API<span class="cw-dot">.</span></h2>
      <p class="mt-6 leading-relaxed">
        <code>$</code> はフックの第 1 引数で、mod が外の世界に触れる唯一の手段です。<code
          >$.名詞.動詞(…)</code
