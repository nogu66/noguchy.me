const bandCode = `const turns = { plugin: "turn-counter", key: "turns" }

export function register(on) {
  on("turn.complete", async ($, e, next) => {
    const r = await next(e)
    if (!e.agentId) {
      const { value = 0 } = await $.state.get(turns)
      await $.state.set(turns, value + 1)
    }
    return r
  })

  on("ui.render", { component: "AbovePrompt" }, async ($, e, next) => {
    const { value = 0 } = await $.state.get(turns) // 描画中の get が購読になる
    if (value === 0) return next(e)
    const { Text } = $.ui.resolve(e)
    return Text({ dimColor: true, children: \`このセッション \${value} ターン目\` })
  })
}`;

const memoryCode = `export function register(on) {
  on("prompt.submit", async ($, e, next) => {
    const notes = await $.store.get("notes").catch(() => undefined)
    if (typeof notes !== "string") return next(e)
    // モデルだけが読む文脈を足す（画面には出ない）
    return next({ ...e, context: [...(e.context ?? []), notes] })
  })
}`;

