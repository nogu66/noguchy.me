const paneCode = `import { atom, read, update } from "claude-code"
import type { Register } from "claude-code"
import type { ToolCall } from "../types"

const PANE = "tool-calls"
const calls = atom({ plugin: "tool-calls", key: "calls" } as const, [])

export const register: Register = on => {
  // 1. コマンドを登録し、ペインを開く
  on("session.start", async ($, e, next) => {
    await $.command.register({ name: "tool-calls", description: "Show tool calls" })
    void $.ui.open({ id: PANE, title: "Tool calls" })
    return next(e)
  })

  // 2. 自作コマンドに答える
  on("command.run", { command: "tool-calls" }, async $ => {
    await $.ui.open({ id: PANE, title: "Tool calls" })
    return { text: "Tool calls pane opened." }
  })

  // 3. 値を $.state に書く（読んでいる描画が自動で描き直される）
  on("tool.call", async ($, e, next) => {
    await update($, calls, list => [...list, { id: e.tool_use_id, tool: e.tool }].slice(-200))
    return next(e)
  })

  // 4. ペインの中身を描く
  on("ui.render", { component: "Pane", requestId: PANE }, async ($, e) => {
    const { Box, Text } = $.ui.resolve(e)
    const list = await read($, calls)
    return (
      <Box flexDirection="column">
        {list.length === 0 && <Text dimColor>No tool calls yet.</Text>}
        {list.map(call => <Text>{call.tool}</Text>)}
      </Box>
    )
  })
}`;

