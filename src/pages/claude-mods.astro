---
import { Code } from "astro:components";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";

const VERSION = "2.1.299";
const UPDATED = "2026-10-14";

const title = "Claude Mods の全体像";
const desc =
  "Claude Code の Mods（function hooks）で何ができて、どう書き、どう始めるのかを 1 ページにまとめました。ハッカソンの補足資料として使えます。";

const codeThemes = { light: "min-light", dark: "night-owl" } as const;

// Escape HTML, then turn `backticks` into <code>
const md = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");

const toc = [
  ["what", "Mods とは"],
  ["shape", "基本形"],
  ["chain", "チェーン"],
  ["events", "イベント"],
  ["api", "$ API"],
  ["ui", "描画"],
  ["patterns", "3 つの型"],
  ["start", "はじめかた"],
  ["gotchas", "ハマりどころ"],
  ["ideas", "アイデア"],
  ["changes", "最近の変更"],
  ["links", "リンク"],
] as const;

const abilities = [
  {
    label: "止める・書き換える",
    body: "ツール実行、プロンプト送信、設定変更などを実行前に受け取り、拒否したり中身を書き換えたりできます。",
    api: "tool.call · prompt.submit · config.set",
  },
  {
    label: "描く",
    body: "サイドパネル、プロンプト欄の上の帯、ツール結果の表示などを自分の UI に差し替えられます。",
    api: "ui.render · $.ui.open · $.ui.toast",
  },
  {
    label: "足す",
    body: "スラッシュコマンド、モデルが呼べるツール、サブエージェントの型を追加できます。",
    api: "$.command · $.tool · $.agent",
  },
];

const compare = [
  ["動く場所", "外部のシェルプロセス", "Claude Code のプロセス内の関数"],
  [
    "やりとり",
    "JSON / テキストと allow・deny",
    "値をそのまま書き換え、UI も返せる",
  ],
  ["タイミング", "決まった時点で 1 回", "next() の前後どちらでも介入できる"],
  ["UI・状態", "持てない", "パネル描画、状態保持、タイマー"],
  ["複数の組み合わせ", "順番の制御が難しい", "登録順のチェーンで自然に合成"],
];

const guardCode = `export function register(on) {
  on("tool.call", { tool: "Bash" }, async ($, e, next) => {
    if (e.command.includes("git push --force")) {
      return { deny: "force push は使わないでください" } // 本体の代わりに答える
    }
    const r = await next(e) // 後ろのフックと本体を実行
    $.ui.toast("Bash ran") // 結果を見てから反応する
    return r
  }).catch(($, e, next) =>
    next.called ? next(e) : { deny: "ガードが失敗したので止めました" })
}`;

const args = [
  {
    k: "$",
    title: "外の世界への唯一の窓口",
    body: "画面、モデル、ファイル、ストア、タイマー、HTTP など。mod は Node も DOM もない環境で動くので、外に触れるのは必ず $ 経由です。$.ui.toast(…) のように省略せず書きます（読み込み時に静的に棚卸しされるため）。",
  },
  {
    k: "e",
    title: "イベントの入力",
    body: "深く freeze されたプレーンなデータ。直接は書き換えられません。変えたいときは next({ ...e, command }) のようにコピーを渡します。",
  },
  {
    k: "next",
    title: "チェーンの残り",
    body: "next(e) で後ろのフックと Claude Code 本体を実行し、その結果を受け取ります。呼ばずに return すれば、本体の代わりに答えたことになります。",
  },
];

const nextUses = [
  ["return next(e)", "そのまま通す"],
  ["return next({ ...e, text })", "入力を書き換えて通す"],
  ['return { deny: "…" }', "本体を動かさずに答える（拒否など）"],
  ["const r = await next(e); …", "結果を見てから反応する・結果を書き換える"],
];

const tiers = [
  ["prepend", "組織ポリシー", "prependPlugins"],
  ["user", "あなたが入れた mod", "ハッカソンで作るのはここ"],
  ["append", "組織ポリシー", "appendPlugins"],
  ["builtin", "バイナリ同梱の mod", "sec-default, diff など"],
  ["core", "Claude Code 本体", "既定の答えを出す"],
] as const;

// ===== Events =====
const lifecycle = [
  ["session.start", "起動"],
  ["prompt.submit", "送信"],
  ["turn.start", "ターン開始"],
  ["turn.step", "モデルに問い合わせ"],
  ["tool.call", "ツール実行前"],
  ["tool.check", "許可判定"],
  ["ui.render", "画面に描く"],
  ["turn.complete", "ターン終了"],
  ["session.end", "終了"],
];

type EventRow = { n: string; when: string; can: string; star?: boolean };
const eventGroups: { cat: string; rows: EventRow[] }[] = [
  {
    cat: "ツール",
    rows: [
      {
        n: "tool.call",
        when: "ツールが実行される直前（許可確認より前）",
        can: "`next({ ...e, command })` で入力を書き換え · `{ deny }` で拒否 · `{ result }` で結果を差し替え · `await next(e)` の後で結果を加工",
        star: true,
      },
      {
        n: "tool.check",
        when: "実行してよいかの判定時（tool.call と PreToolUse の後）",
        can: '`{ decision: "allow" | "ask" | "deny" }`',
      },
      {
        n: "tool.describe",
        when: "ツールの説明を初めてモデルに送るとき",
        can: "`{ description, isDeferred }` で説明を書き換え",
      },
    ],
  },
  {
    cat: "プロンプト",
    rows: [
      {
        n: "prompt.submit",
        when: "プロンプトが送信されたとき（ターン開始前）",
        can: "`next({ ...e, text })` で書き換え · `context` でモデルだけが読む文脈を追加 · `{ drop }` で破棄",
        star: true,
      },
      {
        n: "prompt.edit",
        when: "入力欄が編集されるたび（キー入力・貼り付け）",
        can: "挿入される文字や入力欄の中身を書き換え",
      },
      {
        n: "prompt.fill",
        when: "入力欄に下書きが入る直前（$.prompt.fill）",
        can: "文字列やモードを書き換え · `{ isFilled: false }` で入れない",
      },
      {
        n: "prompt.suggest",
        when: "入力欄に薄字の提案が出るとき（Tab で採用）",
        can: "`next({ ...e, text })` で書き換え · `{ isShown: false }` で出さない",
      },
      {
        n: "prompt.autocomplete",
        when: "入力中、カーソル位置の単語の補完候補を作るとき",
        can: "`{ suggestions: [{ text }] }` で候補を追加",
      },
      {
        n: "prompt.mention",
        when: "@ で指定したファイルを読む直前",
        can: "`context` を追加 · 別の `path` を読ませる · `{ deny }`",
      },
      {
        n: "prompt.compose",
        when: "システムプロンプトを組み立てるとき",
        can: "`{ sections }` の追加・置き換え・並べ替え・削除",
      },
      {
        n: "prompt.section",
        when: "システムプロンプトの名前付きセクションごと",
        can: "`{ text }` で差し替え · `{ text: null }` で削除",
      },
      {
        n: "prompt.context",
        when: "会話ごとに 1 回、最初のメッセージに添える文脈を作るとき",
        can: "`{ blocks }` を追加・削除・書き換え",
      },
      {
        n: "prompt.attachment",
        when: "リマインダーなど、本体が自動で足すメッセージごと",
        can: "`{ text }` で差し替え · `{ text: null }` で外す",
      },
      {
        n: "skill.prompt",
        when: "スキル本文をモデル向けに展開するとき",
        can: "`{ text }` で差し替え",
      },
      {
        n: "attribution.text",
        when: "コミット / PR 文に入れる帰属テキストを作るとき",
        can: "`{ text }` で差し替え",
      },
    ],
  },
  {
    cat: "コマンドと設定",
    rows: [
      {
        n: "command.run",
        when: "スラッシュコマンドの実行直前",
        can: "`{ text }` で答える（自作コマンドの応答はここ）· `next({ ...e, args })` で引数を書き換え",
        star: true,
      },
      {
        n: "command.describe",
        when: "コマンドを補完一覧や /help に出すとき",
        can: "`{ description, argumentHint, isHidden }`",
      },
      {
        n: "config.set",
        when: "/config の行が変わる直前",
        can: "`{ deny }` で変更させない · `next({ ...e, value })` で値を補正",
      },
      {
        n: "config.describe",
        when: "/config の行を一覧に出すとき",
        can: "`{ label, description, isHidden }`",
      },
    ],
  },
  {
    cat: "ターン",
    rows: [
      {
        n: "turn.start",
        when: "ターン開始時（サブエージェントも。メインは `e.agentId` なし）",
        can: "観察のみ",
      },
      {
        n: "turn.step",
        when: "モデルへのリクエスト 1 回ごと",
        can: "`model` / `effort` を差し替え · 応答ストリームを加工（async generator で書く）",
      },
      {
        n: "turn.complete",
        when: "ターンが終わったとき",
        can: "`{ text }` で回答の下に一行表示（記録は変わらない）",
        star: true,
      },
    ],
  },
  {
    cat: "セッション",
    rows: [
      {
        n: "session.start",
        when: "最初のプロンプトの前と、mod のリロード後（/clear 後は来ない）",
        can: "観察のみ。コマンドやツールの登録、タイマー開始はここで行う",
        star: true,
      },
      {
        n: "session.end",
        when: "終了・/clear・/resume など（`e.reason`）",
        can: "観察のみ（全フック合わせて短い時間制限あり）",
      },
      {
        n: "session.compact",
        when: "会話を圧縮する直前",
        can: "指示やメッセージを書き換え · `{ skip }` で圧縮しない",
      },
      {
        n: "session.append",
        when: "会話に行が保存される直前",
        can: "`next({ ...e, message })` で内容を書き換え（マスキングなど）",
      },
      {
        n: "session.send",
        when: "他のエージェント / セッションへメッセージを送る直前",
        can: "本文・宛先を書き換え · `{ isDelivered: false }` で送らない",
      },
      {
        n: "session.receive",
        when: "外からメッセージが届いたとき",
        can: "`next({ ...e, text })` で書き換え · `{ consumed }` で受け取って捨てる",
      },
      {
        n: "session.attach · detach",
        when: "スマホなどリモートの画面が接続・離脱したとき",
        can: "観察のみ",
      },
      {
        n: "session.measure",
        when: "ターン後など、使用量の数字が動いたとき",
        can: "観察のみ（`$.session.usage()` の値が届く）",
      },
    ],
  },
  {
    cat: "サブエージェント",
    rows: [
      {
        n: "agent.offer",
        when: "サブエージェントの型をモデルに見せるとき",
        can: "`{ isOffered: false }` で隠す",
      },
      {
        n: "agent.spawn",
        when: "サブエージェントやチームメイトの起動・再開の直前",
        can: "`next({ ...e, model })` でモデルを変える · `{ deny }`",
      },
    ],
  },
  {
    cat: "画面",
    rows: [
      {
        n: "ui.render",
        when: "各描画箇所を描く直前（→ 描画セクション）",
        can: "要素ツリーを返す · `await next(e)` の描画を包む · `props` を書き換え · `next(e)` で何もしない",
        star: true,
      },
      {
        n: "ui.press",
        when: "自分が描いた Button が押されたとき",
        can: "`next(e)` で onPress を実行 · 横取りして別の動作",
      },
      {
        n: "ui.input · ui.select",
        when: "Input の入力・確定 / Select の選択",
        can: "値を書き換えて onInput・onSubmit / onSelect に渡す",
      },
      {
        n: "ui.focus · ui.scroll",
        when: "ペインや帯でフォーカス・スクロール位置が動く直前",
        can: "移動先を変える · `{ deny }` で動かさない",
      },
      {
        n: "ui.close",
        when: "ペインが閉じる直前（`e.origin.kind`: plugin · person · unload）",
        can: "閉じる前の後片付け",
      },
      {
        n: "ui.message",
        when: "自分の Client が `surface.post(data)` したとき",
        can: "データを受け取る · `{ props }` で再描画なしに渡し返す",
      },
      {
        n: "ui.fault",
        when: "自分の Client の読み込み・描画・実行が失敗したとき",
        can: "観察のみ（ログを出してフォールバック）",
      },
      {
        n: "ui.resolve",
        when: "読み込み時、描画面と描画箇所ごとに 1 回",
        can: "要素テーブルを差し替え（他の mod の要素のスタイルを変える）",
      },
    ],
  },
  {
    cat: "メタ",
    rows: [
      {
        n: "plugin.register",
        when: "他の mod が読み込まれる直前",
        can: "`{ refuse }` で読み込ませない（組織の審査用）",
      },
      {
        n: "engine.create",
        when: "この mod 用の $ を組み立てるとき",
        can: "$ に名詞を足す（user tier は追加のみ）",
      },
      {
        n: "telemetry.log · mark",
        when: "テレメトリが記録される直前",
        can: '中身を書き換え · `{ deny }`。マッチャーで `{ to: "collector" }` を指定',
      },
      {
        n: "classic.<Event>",
        when: "settings の従来フック（PreToolUse など）が動くとき",
        can: "e は従来の stdin JSON。返り値も従来と同じ",
      },
      {
        n: "<noun>.<method>",
        when: "他の mod が $ を呼んだとき（例: `fs.read`）",
        can: "`{ deny }` · `{ value }` で代わりに答える",
      },
      {
        n: "*",
        when: "上のすべて（telemetry 以外）",
        can: '`"tool.*"` のような glob も使える',
      },
    ],
  },
];

// ===== $ API =====
type Method = [string, string];
const apiGroups: {
  cat: string;
  nouns: { noun: string; methods: Method[] }[];
}[] = [
  {
    cat: "画面に出す",
    nouns: [
      {
        noun: "$.ui",
        methods: [
          ["toast(text)", "画面下の通知バーに数秒表示"],
          ["status(text)", "ステータス行に表示（`undefined` で消す）"],
          ["log(text)", "トランスクリプトに一行足す"],
          ["notify(text, { title })", "OS のネイティブ通知"],
          ["notice(text)", "ダイアログの下に一行"],
          ["ask(…)", "AskUserQuestion のダイアログで質問する"],
          [
            "open({ id, title }) · close({ id }) · panes()",
            "ペインを開く・閉じる・一覧",
          ],
          ["focus(…) · scroll(…)", "フォーカス・スクロール位置を動かす"],
          ["copy({ text })", "クリップボードにコピー"],
          ["selection()", "マウスで最後に選択したテキスト"],
          ['invalidate("ui.render")', "再描画を依頼（$.state なら不要）"],
          ["resolve(e)", "その画面の要素（Box, Text …）を得る"],
          ["blit(…)", "再描画なしで Raster / Image を差し替え"],
        ],
      },
    ],
  },
  {
    cat: "モデルとプロンプト",
    nouns: [
      {
        noun: "$.model",
        methods: [
          [
            "complete({ model, prompt })",
            "履歴なしの単発補完。結果は `{ isAnswered, text }`",
          ],
          ["fork({ prompt })", "この会話の続きとして、ツールなしで 1 回質問"],
          ["classify(text, labels)", "ラベルを 1 つ選ばせる"],
        ],
      },
      {
        noun: "$.prompt",
        methods: [
          ["submit(…)", "プロンプトを送る（暇になったら新しいターンを始める）"],
          ["read()", "入力欄の中身を読む"],
          ["fill({ text, mode })", "入力欄に書く（replace · append · insert）"],
          ["suggest(…)", "入力欄に薄字で提案"],
          ["compose()", "システムプロンプトを組み立てて得る"],
          ["media({ id })", "添付画像・文書の中身（managed の mod のみ）"],
        ],
      },
    ],
  },
  {
    cat: "機能を足す",
    nouns: [
      {
        noun: "$.command",
        methods: [
          [
            "register({ name, description })",
            "/コマンドを追加。応答は `command.run` で返す",
          ],
          ["run(…)", "コマンドを入力したように実行"],
          ["list()", "コマンドの一覧"],
        ],
      },
      {
        noun: "$.tool",
        methods: [
          [
            "register({ name, description, inputSchema })",
            "モデルが呼べるツールを追加（`mcp__<plugin>__<name>`）。応答は `tool.call` で返す",
          ],
          ["call(…)", "フックと権限を通してツールを実行"],
          ["check(…)", "許可判定だけを得る"],
          ["list()", "今あるツールの一覧"],
        ],
      },
      {
        noun: "$.agent",
        methods: [
          ["register(…)", "サブエージェントの型を追加（`<plugin>:<name>`）"],
          [
            "spawn({ subagentType, … })",
            "サブエージェントを起動し、終わるまで待つ",
          ],
          ["list()", "動いているエージェントの一覧"],
        ],
      },
    ],
  },
  {
    cat: "セッションを知る・操作する",
    nouns: [
      {
        noun: "$.session",
        methods: [
          ["id() · cwd() · root() · repo()", "セッションの識別子と場所"],
          [
            "model() · version() · turns()",
            "モデル · Claude Code のバージョン · ターン数",
          ],
          [
            "messages()",
            "会話（1 メッセージ 1 項目の `{ role, text, toolUses }`）",
          ],
          ["usage()", "コンテキスト使用率 · レート制限 · コスト"],
          [
            "compact() · append({ message }) · send(…)",
            "今すぐ圧縮 · 会話に行を足す · 他セッションへ送る",
          ],
          ["surfaces()", "接続中の画面（ターミナル · デスクトップ · スマホ）"],
          [
            "authorize()",
            "Anthropic 認証のハンドル（`$.http.fetch` の auth 用。秘密は渡らない）",
          ],
          ["identity()", "サインイン情報（managed の mod のみ）"],
        ],
      },
      {
        noun: "$.turn",
        methods: [["abort()", "実行中のターンを止める"]],
      },
    ],
  },
  {
    cat: "データを持つ",
    nouns: [
      {
        noun: "$.state",
        methods: [
          [
            "get(ref) · set(ref, value)",
            "セッション中の値。リロードしても残り、描画中に get すると set で自動再描画",
          ],
          [
            "atom · read · update · derive",
            '`"claude-code"` から import する補助関数',
          ],
        ],
      },
      {
        noun: "$.store",
        methods: [
          [
            "get(key) · set(key, value) · delete(key) · keys()",
            "マシン上の全セッションで共有する KV（JSON、合計 4 MiB）",
          ],
        ],
      },
      {
        noun: "$.fs",
        methods: [
          [
            "read(path) · write(path, text) · list(path)",
            "ファイルの読み書き（write は非アトミック）",
          ],
          [
            "exists(path) · stat(path) · ancestors(…)",
            "存在確認 · 種類やサイズ · 上位フォルダの指示ファイル",
          ],
        ],
      },
    ],
  },
  {
    cat: "外とつながる",
    nouns: [
      {
        noun: "$.http",
        methods: [["fetch(url, init)", "ホスト経由の HTTP リクエスト"]],
      },
      {
        noun: "$.process",
        methods: [
          [
            "run({ argv }) · spawn({ argv })",
            "コマンドを実行（シェルなし）· 出力をストリームで受ける",
          ],
        ],
      },
      {
        noun: "$.mcp",
        methods: [
          [
            "call(…) · connect(…)",
            "接続済み MCP サーバーのツールを呼ぶ · 接続する",
          ],
        ],
      },
    ],
