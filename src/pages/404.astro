---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`} noindex>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl leading-none font-black">
        404<span class="text-cobalt">.</span>
      </h1>
      <p class="cw-lead mt-4">Page Not Found</p>
      <a href="/" class="cw-btn cw-btn--cobalt my-6">Go back home</a>
    </div>
  </main>

  <Footer />
</Layout>
