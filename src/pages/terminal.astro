---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import type { TermPost } from "@/utils/terminalShell";
import { SITE } from "@/config";
import { NEWS } from "@/news.config";
import { SOCIALS } from "@/constants";

const PAGE_SIZE = 5;
const TAB_COUNT = 5;

const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  timeZone: SITE.timezone,
});

const sortedPosts = getSortedPosts(
  await getCollection("blog", ({ data }) => data.published)
);

const toTermPost = ({
  id,
  filePath,
  body,
  data,
}: (typeof sortedPosts)[number]): TermPost => ({
  title: data.title,
  href: getPath(id, filePath),
  date: dateFormat.format(data.modDatetime ?? data.pubDatetime),
  tags: data.tags.map(slugifyStr),
  // Japanese reads at roughly 500 characters per minute
  mins: Math.max(1, Math.round((body?.length ?? 0) / 500)),
  desc: data.description,
});

const featured = sortedPosts.filter(p => p.data.featured).map(toTermPost);
const posts = sortedPosts.filter(p => !p.data.featured).map(toTermPost);

const tagCounts = new Map<string, { name: string; count: number }>();
for (const post of sortedPosts.filter(p => !p.data.featured)) {
  for (const name of post.data.tags) {
    const tag = slugifyStr(name);
    const entry = tagCounts.get(tag) ?? { name, count: 0 };
    entry.count += 1;
    tagCounts.set(tag, entry);
  }
}
const tags = [...tagCounts]
  .map(([tag, { name, count }]) => ({ tag, name, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const talks = (await getCollection("talks")).map(({ id, data }) => ({
  label: "TALK",
  title: data.title,
  href: `/talks/${id}`,
  time: data.date.getTime(),
}));
const awards = (await getCollection("awards")).map(({ id, data }) => ({
  label: "AWARD",
  title: `${data.title}（${data.award}）`,
  href: `/awards/${id}`,
  time: data.date.getTime(),
}));
const activities = [...talks, ...awards]
  .sort((a, b) => b.time - a.time)
  .map(({ time, ...rest }) => ({ ...rest, date: dateFormat.format(time) }));

const social = (name: string) => SOCIALS.find(s => s.name === name)?.href ?? "";

const termData = {
  featured,
  posts,
  tags,
  activities,
  links: { news: NEWS.website, github: social("GitHub"), x: social("X") },
};

// 5-row block font for the banner; "#" marks a filled cell
const GLYPHS: Record<string, string[]> = {
  n: ["#   #", "##  #", "# # #", "#  ##", "#   #"],
  o: [" ### ", "#   #", "#   #", "#   #", " ### "],
  g: [" ####", "#    ", "#  ##", "#   #", " ####"],
  u: ["#   #", "#   #", "#   #", "#   #", " ### "],
  c: [" ####", "#    ", "#    ", "#    ", " ####"],
  h: ["#   #", "#   #", "#####", "#   #", "#   #"],
  y: ["#   #", " # # ", "  #  ", "  #  ", "  #  "],
  ".": [" ", " ", " ", " ", "#"],
  m: ["#   #", "## ##", "# # #", "#   #", "#   #"],
  e: ["#####", "#    ", "#### ", "#    ", "#####"],
};
const banner = [0, 1, 2, 3, 4]
  .map(row =>
    [...SITE.title]
      .map(char => GLYPHS[char]?.[row] ?? "")
      .join(" ")
      .replaceAll("#", "█")
  )
  .join("\n");

const menu = [
  { key: "H", label: "HOME", href: "/" },
  { key: "P", label: "POSTS", href: "/posts" },
  { key: "T", label: "TAGS", href: "/tags" },
  { key: "A", label: "ABOUT", href: "/about" },
  { key: "C", label: "ACTIVITIES", href: "/activities" },
  { key: "N", label: "NEWS", href: NEWS.website },
];

const description =
  "noguchy.me をシェルとして操作するページ。記事一覧はスクロールバック、ナビゲーションはプロンプト。/help で開始。";
---

<Layout
  title={`Terminal | ${SITE.title}`}
  description={description}
  bodyClass="term-page"
>
  <div class="term-layout" id="term-root">
    <aside class="term-side">
      <a href="/" class="term-logo" aria-label="Home">
        <img src="/profile.png" alt="" width="40" height="40" />
        <span>{SITE.title}</span>
      </a>
      <nav class="term-menu" id="term-menu" aria-label="Site">
        {
          menu.map(({ key, label, href }) => (
            <a href={href} data-key={key}>
              <span class="k">[{key}]</span>
              <span>{label}</span>
            </a>
          ))
        }
        <a href="/terminal" class="on" aria-current="page">
          <span class="k">[/]</span>
          <span>TERMINAL</span>
        </a>
      </nav>
    </aside>

    <main class="term-main" id="main-content">
      <h1 class="sr-only">Terminal</h1>
      <div class="term-rows" id="term-rows">
        <pre class="term-banner" aria-hidden="true">{banner}</pre>
        <p class="term-sub">
          AIエージェント開発や生成AI活用について書いています。下のプロンプトに
          <span class="cmd">/help</span> と入力するとコマンド一覧を表示します。
        </p>

        <div class="term-feeds">
          {
            featured.length > 0 && (
              <div id="term-featured">
                {featured.map((post, i) => (
                  <a class="frow" href={post.href} style={`--i:${i}`}>
                    <span class="f-l">Featured</span>
                    <span class="f-t">{post.title}</span>
                    <span class="f-d">{post.mins} min</span>
                  </a>
                ))}
              </div>
            )
          }

          <div class="term-tabs" id="term-tabs">
            <button type="button" class="on" data-tag="all" aria-pressed="true">
              ALL
            </button>
            {
              tags.slice(0, TAB_COUNT).map(({ tag, name }) => (
                <button type="button" data-tag={tag} aria-pressed="false">
                  {name}
                </button>
              ))
            }
          </div>

          <div id="term-feed">
            {
              posts.slice(0, PAGE_SIZE).map((post, i) => (
                <a
                  class="frow"
                  href={post.href}
                  style={`--i:${featured.length + i}`}
                >
                  <span class="f-l">{post.date}</span>
                  <span class="f-t">{post.title}</span>
                  <span class="f-d">{post.mins} min</span>
                </a>
              ))
            }
          </div>
          <button
            type="button"
            class="term-more"
            id="term-more"
            hidden={posts.length <= PAGE_SIZE}
          >
            <span></span>
            <span class="lm">LOAD MORE</span>
            <span class="hint">/posts for more</span>
          </button>

          <div class="term-scroll" id="term-out" aria-live="polite"></div>
        </div>
      </div>

      <form class="term-dock" id="term-form">
        <div class="term-suggest" id="term-suggest"></div>
        <span class="term-user">guest@noguchy.me</span>
        <span class="term-gt" aria-hidden="true">&gt;</span>
        <input
          class="term-input"
          id="term-input"
          placeholder="/help"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          enterkeyhint="go"
          aria-label="terminal input"
        />
      </form>
    </main>
  </div>

  <script
    type="application/json"
    id="term-data"
    is:inline
    set:html={JSON.stringify(termData).replace(/</g, "\\u003c")}
  />
</Layout>

<script>
  import "@/scripts/terminal";
</script>

<style is:global>
  html:has(body.term-page) {
    overflow: hidden;
  }
  .term-page {
    height: 100dvh;
    overflow: hidden;
  }

  .term-layout {
    --term-size: clamp(0.75rem, 0.68rem + 0.29vw, 0.875rem);
    --term-label: 7.5rem;
    --term-gap: 1.5rem;
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    width: 100%;
    height: 100dvh;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      monospace;
    font-size: var(--term-size);
    line-height: 1.65;
  }

  /* ----- sidebar ----- */
  .term-side {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-right: 1px solid var(--border);
  }
  .term-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--foreground-dark);
  }
  .term-logo img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
  }
  .term-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
  }
  .term-menu a {
    display: flex;
    padding: 5px 0;
    color: var(--muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      color 0.12s,
      transform 0.2s ease-out;
  }
  .term-menu a:hover {
    transform: translateX(4px);
  }
  .term-menu a:hover,
  .term-menu a.on {
    color: var(--foreground-dark);
  }
  .term-menu .k {
    margin-right: 6px;
    opacity: 0.7;
  }

  /* ----- main column ----- */
  .term-main {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-width: 55rem;
    padding: 0 2rem 1.25rem;
    overflow: hidden;
  }
  .term-rows {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .term-rows::-webkit-scrollbar {
    display: none;
  }
  .term-banner {
    flex: none;
    margin: 2rem 0 0.5rem;
    overflow: hidden;
    font-family: inherit;
    font-size: clamp(7px, 2.5vw, 13px);
    line-height: 1;
    color: var(--foreground-dark);
  }
  .term-sub {
    max-width: 41rem;
    margin: 0.5rem 0 3rem;
    color: var(--muted);
  }
  .term-sub .cmd {
    color: var(--foreground-dark);
  }
  .term-feeds {
    margin-top: auto;
  }

  /* ----- feed rows ----- */
  .frow,
  .term-more {
    display: grid;
    grid-template-columns: var(--term-label) minmax(0, 1fr) auto;
    gap: 0 var(--term-gap);
    align-items: baseline;
    width: 100%;
    padding: 4px 2px;
    text-align: left;
    transition: background 0.12s;
  }
  .frow {
    animation: term-pop 0.4s ease-out both;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .frow .f-l,
  .frow .f-d,
  .term-more .hint {
    color: var(--muted);
    transition: transform 0.18s ease-out;
  }
  .frow .f-t {
    overflow: hidden;
    color: var(--foreground-dark);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term-more {
    letter-spacing: 0.02em;
  }
  .term-more[hidden] {
    display: none;
  }
  .term-more .lm {
    color: var(--foreground-dark);
  }
  .frow:hover,
  .frow:focus-visible,
  .term-more:hover,
  .term-more:focus-visible {
    background: var(--foreground-dark);
    outline: none;
  }
  .frow:hover > span,
  .frow:focus-visible > span,
  .term-more:hover > span,
  .term-more:focus-visible > span {
    color: var(--background);
  }
  .frow:hover .f-l,
  .frow:focus-visible .f-l {
    transform: translateX(12px);
  }
  .frow:hover .f-d,
  .frow:focus-visible .f-d,
  .term-more:hover .hint,
  .term-more:focus-visible .hint {
    transform: translateX(-12px);
  }
  .f-empty {
    padding: 14px 2px;
    color: var(--muted);
  }
  .f-empty .gt {
    margin-right: 8px;
    color: var(--accent);
  }

  /* ----- tag tabs ----- */
  .term-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 1rem 0 0.6rem;
    padding: 0.75rem 2px;
    border-block: 1px solid var(--border);
  }
  .term-tabs button {
    color: var(--muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .term-tabs button:hover,
  .term-tabs button.on {
    color: var(--foreground-dark);
  }
  .term-tabs button.on {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* ----- command output ----- */
  .term-scroll {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 1.5rem 0 10px;
  }
  .term-scroll:empty {
    margin: 0;
  }
  .term-scroll .t-out {
    margin-top: 2px;
    color: var(--muted);
    white-space: pre-wrap;
  }
  .term-scroll .t-cmd {
    width: fit-content;
    margin: 6px 0 2px;
    padding: 3px 10px;
    font-weight: 500;
    color: var(--foreground-dark);
    background: var(--light);
  }
  .term-scroll .t-cmd:first-child {
    margin-top: 0;
  }
  .term-scroll .t-cmd::before {
    color: var(--muted);
    content: "> ";
  }
  .term-scroll .t-opt {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: 0 var(--term-gap);
    padding: 1px 2px;
    cursor: pointer;
    transition:
      background 0.12s,
      color 0.12s;
  }
  .term-scroll .t-opt .t-v {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term-scroll .t-opt.on,
  .term-scroll .t-opt:hover {
    color: var(--background);
    background: var(--foreground-dark);
  }

  /* ----- prompt ----- */
  .term-dock {
    position: relative;
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
    padding: 14px 2px;
    border-block: 1px solid var(--border);
  }
  .term-user {
    color: var(--foreground-dark);
  }
  .term-gt {
    color: var(--accent);
  }
  .term-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--foreground-dark);
    caret-color: var(--accent);
    background: none;
    border: 0;
    outline: 0;
  }
  .term-input::placeholder {
    color: var(--muted);
    opacity: 0.6;
  }
  .term-suggest {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    left: 0;
    z-index: 10;
    display: none;
    padding: 5px;
    background: var(--background);
    border: 1px solid var(--border);
    box-shadow: 0 -8px 30px rgb(0 0 0 / 0.18);
  }
  .term-suggest.open {
    display: block;
  }
  .term-suggest .sug {
    display: flex;
    gap: 14px;
    padding: 4px 8px;
    cursor: pointer;
  }
  .term-suggest .sc {
    flex: none;
    min-width: 11rem;
    color: var(--foreground-dark);
  }
  .term-suggest .sd {
    overflow: hidden;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term-suggest .sug.on,
  .term-suggest .sug:hover {
    background: var(--foreground-dark);
  }
  .term-suggest .sug.on > span,
  .term-suggest .sug:hover > span {
    color: var(--background);
  }

  @keyframes term-pop {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frow {
      animation: none;
    }
  }

  /* touch keyboards zoom the page when an input is below 16px */
  @media (pointer: coarse) {
    .term-input {
      font-size: 16px;
    }
  }

  @media (max-width: 900px) {
    .term-layout {
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-columns: minmax(0, 1fr);
    }
    .term-side {
      flex-direction: row;
      gap: 1rem;
      align-items: center;
      padding: 0.75rem 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .term-logo span,
    .term-menu .k,
    .term-menu a.on {
      display: none;
    }
    .term-menu {
      flex-direction: row;
      gap: 1rem;
      margin: 0 0 0 auto;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .term-menu a:hover {
      transform: none;
    }
    .term-main {
      max-width: none;
      padding: 0 1rem 1rem;
    }
    .term-banner {
      margin-top: 1.25rem;
    }
    .term-sub {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 640px) {
    .frow,
    .term-more {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .frow .f-l,
    .term-more > span:first-child,
    .term-user {
      display: none;
    }
    .term-scroll .t-opt {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 1ch;
    }
    .term-suggest .sc {
      min-width: 0;
    }
    .frow:hover .f-d,
    .term-more:hover .hint {
      transform: none;
    }
  }
</style>
