---
import { getCollection, type CollectionEntry } from "astro:content";
import { NEWS } from "@/news.config";
import { getNewsPath } from "@/utils/getNewsPath";
import getSortedNews from "@/utils/getSortedNews";

export interface Props {
  newsItem: CollectionEntry<"news">;
}

export async function getStaticPaths() {
  const news = getSortedNews(await getCollection("news"));
  return news.map(newsItem => ({
    params: { slug: getNewsPath(newsItem.id, newsItem.filePath, false) },
    props: { newsItem },
  }));
}

const { newsItem } = Astro.props;
return Astro.redirect(
  new URL(getNewsPath(newsItem.id, newsItem.filePath), NEWS.website).href,
  301
);
---
