---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Socials from "@/components/Socials.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.website,
  image: new URL(SITE.ogImage ? `/${SITE.ogImage}` : "/og.png", SITE.website)
    .href,
  sameAs: SOCIALS.map(social => social.href),
  description: SITE.desc,
};
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personStructuredData)}
    />
  </Fragment>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section id="about" class="mb-16">
      <SectionHeading as="h1" label="わたしについて">
        {frontmatter.title}
      </SectionHeading>
      <div class="app-prose cw-lead mt-10 max-w-read">
        <slot />
      </div>
      {
        SOCIALS.length > 0 && (
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="cw-label text-ink-muted">Social Links</div>
            <Socials />
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
