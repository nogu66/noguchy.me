---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

export interface Props {
  award: CollectionEntry<"awards">;
}

const { award } = Astro.props;

const {
  title,
  date,
  award: awardName,
  projectUrl,
  eventUrl,
  tags,
} = award.data;

const { Content } = await render(award);

// フォーマット済みの日付
const formatDate = (date: Date) => {
  return date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  description: `${title}で${awardName}を受賞`,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "mx-auto w-full max-w-read px-4 pb-16",
      { "mt-8": !SITE.showBackButton },
    ]}
  >
    <article class="app-prose mx-auto">
      <!-- タイトルと受賞情報 -->
      <div
        class="not-prose mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
      >
        <h1 class="flex-1 text-2xl leading-snug sm:text-[33.28px]">
          {title}
        </h1>
        <span
          class="shrink-0 self-start bg-cobalt px-4 py-2 text-sm leading-none font-black text-on-cobalt"
        >
          {awardName}
        </span>
      </div>

      <!-- 日付情報 -->
      <div class="not-prose mb-6">
        <p class="cw-ui text-ink-muted">{formatDate(date)}</p>
      </div>

      <!-- リンクボタン -->
      <div class="not-prose mb-8 flex flex-wrap gap-3">
        {
          projectUrl && (
            <a
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cw-btn cw-btn--cobalt"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <span>Project</span>
            </a>
          )
        }
        {
          eventUrl && (
            <a
              href={eventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cw-btn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              <span>Event Page</span>
            </a>
          )
        }
      </div>

      <!-- タグ -->
      {
        tags && tags.length > 0 && (
          <ul class="not-prose mb-8 flex flex-wrap gap-2">
            {tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} />
            ))}
          </ul>
        )
      }

      <!-- Markdownコンテンツ -->
      <div>
        <Content />
      </div>

      <ShareLinks {title} />
    </article>
  </main>
  <Footer />
</Layout>
