---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/NewsLayout.astro";
import Header from "@/components/NewsHeader.astro";
import Footer from "@/components/NewsFooter.astro";
import NewsDate from "@/components/NewsDate.astro";
import NewsShare from "@/components/NewsShare.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getNewsPath } from "@/utils/getNewsPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";
import { NEWS } from "@/news.config";

export interface Props {
  newsItem: CollectionEntry<"news">;
  news: CollectionEntry<"news">[];
}

const { newsItem, news } = Astro.props;
const {
  title,
  author,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  contents,
  thumbnail,
  ogImage,
} = newsItem.data;
const { Content } = await render(newsItem);
const readingMinutes = Math.max(
  1,
  Math.ceil((newsItem.body ?? "").replace(/https?:\/\/\S+/g, "").length / 600)
);
const shareURL = new URL(
  getNewsPath(newsItem.id, newsItem.filePath),
  NEWS.website
).href;

const allNews = news.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));
const currentNewsIndex = allNews.findIndex(item => item.id === newsItem.id);
const prevNews = currentNewsIndex > 0 ? allNews[currentNewsIndex - 1] : null;
const nextNews =
  currentNewsIndex >= 0 && currentNewsIndex < allNews.length - 1
    ? allNews[currentNewsIndex + 1]
    : null;
---

<Layout
  title={`${title} | ${SITE.title}`}
  {author}
  {description}
  {pubDatetime}
  {modDatetime}
  ogImage={(typeof ogImage === "string" ? ogImage : ogImage?.src) ?? thumbnail}
  scrollSmooth
>
  <Header />
  <div class="mx-auto w-full max-w-3xl px-4 py-5">
    <a href="/" class="text-sm text-muted hover:text-accent">← ニュース一覧</a>
  </div>
  <main
    id="main-content"
    class:list={[
      "mx-auto w-full max-w-3xl px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    data-pagefind-body
  >
    <header
      class="news-article-heading border-b border-border pt-4 pb-7 sm:pt-8 sm:pb-9"
    >
      <p
        class="mb-4 text-xs font-semibold tracking-[0.2em] text-accent uppercase"
      >
        {tags[0] ?? "News"}
      </p>
      <h1
        transition:name={slugifyStr(title)}
        class="font-bold text-foreground-dark"
      >
        {title}
      </h1>
      <div class="news-article-meta">
        <NewsDate {pubDatetime} {modDatetime} {timezone} />
        <span
          >執筆：<a href={SITE.website} class="hover:text-accent">{author}</a
          ></span
        >
        <span>約{readingMinutes}分で読めます</span>
      </div>
    </header>

    {
      thumbnail && (
        <figure class="news-article-cover">
          <img
            src={thumbnail}
            alt={title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    {
      contents.length > 0 && (
        <details
          open
          class="news-contents mx-auto mt-8 max-w-3xl border-y border-border py-5 sm:mt-10 sm:py-6"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <h2 class="text-lg font-bold text-foreground-dark">記事の内容</h2>
            <span class="flex items-center gap-3 text-xs text-muted">
              {contents.length}項目
              <span
                aria-hidden="true"
                class="contents-toggle text-xl leading-none text-accent"
              >
                +
              </span>
            </span>
          </summary>
          <ol class="mt-4 space-y-2">
            {contents.map((content, index) => (
              <li class="flex gap-3 text-sm leading-relaxed">
                <span class="font-mono text-accent/75">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{content}</span>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="mx-auto mt-10 max-w-3xl sm:mt-12">
      <p class="mb-8 text-lg leading-relaxed text-foreground-dark">
        {description}
      </p>
      <article
        id="article"
        class="news-article-body app-prose max-w-none prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />
      </article>
    </div>

    <hr class="my-8 border-dashed" />
    <ul class="my-8 flex flex-wrap gap-2">
      {
        tags.map(tag => (
          <li class="rounded-sm bg-light px-3 py-1 text-sm text-muted">
            <a
              href={`/?tag=${encodeURIComponent(tag)}`}
              class="hover:text-accent"
            >
              #{tag} のニュース
            </a>
          </li>
        ))
      }
    </ul>
    <BackToTopButton />
    <NewsShare {title} url={shareURL} />
    <hr class="my-6 border-dashed" />
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevNews && (
          <a
            href={getNewsPath(prevNews.id, prevNews.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <div>
              <span>新しいニュース</span>
              <div class="text-sm text-accent/85">{prevNews.title}</div>
            </div>
          </a>
        )
      }
      {
        nextNews && (
          <a
            href={getNewsPath(nextNews.id, nextNews.filePath)}
            class="flex w-full justify-end text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>以前のニュース</span>
              <div class="text-sm text-accent/85">{nextNews.title}</div>
            </div>
          </a>
        )
      }
    </div>
    <a
      href="/"
      class="mt-8 block rounded border border-border px-4 py-3 text-center text-sm hover:text-accent"
      >ニュース一覧に戻る →</a
    >
  </main>
  <NewsFooter />
</Layout>

<style>
  .news-contents summary::-webkit-details-marker {
    display: none;
  }

  .contents-toggle {
    transition: transform 180ms ease-out;
  }

  .news-contents[open] .contents-toggle {
    transform: rotate(45deg);
  }
</style>
