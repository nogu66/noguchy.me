---
import { slugifyStr } from "@/utils/slugify";
import { getListedPostPath, type ListedPost } from "@/utils/getListedPosts";
import Datetime from "./Datetime.astro";

export type Props = ListedPost & {
  variant?: "h2" | "h3";
};

const { variant = "h2", data } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, tags } = data;

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "line-clamp-2 text-xl leading-snug font-black group-hover:text-cobalt",
};
---

<li class="relative flex flex-col py-6">
  <Datetime {pubDatetime} {modDatetime} {timezone} />
  <a
    href={getListedPostPath(Astro.props)}
    class="group mt-2 inline-block after:absolute after:inset-0 after:rounded-(--radius-lg) after:content-[''] focus-visible:no-underline"
  >
    {
      variant === "h2" ? (
        <h2 {...headerProps}>{title}</h2>
      ) : (
        <h3 {...headerProps}>{title}</h3>
      )
    }
  </a>
  <p class="mt-2 line-clamp-2 text-ink-muted">{description}</p>
  {
    tags && tags.length > 0 && (
      <ul class="cw-label mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-3 text-cobalt">
        {tags.map(tag => (
          <li>#{tag}</li>
        ))}
      </ul>
    )
  }
</li>
