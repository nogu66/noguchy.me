---
export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li class="inline-block">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={["cw-chip", { "cw-chip--sm": size === "sm" }]}
  >
    <span aria-hidden="true">#</span>{tagName}
  </a>
</li>
