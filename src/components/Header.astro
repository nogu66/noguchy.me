---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconTerminal from "@/assets/icons/IconTerminal.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import SearchModal from "./SearchModal.astro";
import { SITE } from "@/config";
import { NEWS } from "@/news.config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { href: NEWS.website, label: "News", external: true },
  { href: "/posts", label: "Posts" },
  { href: "/tags", label: "Tags" },
  { href: "/activities", label: "Activities" },
  { href: "/about", label: "About" },
  ...(SITE.showArchives ? [{ href: "/archives", label: "Archives" }] : []),
];
---

<header class="sticky top-0 z-30 border-b border-line bg-surface">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-surface px-3 py-2 text-cobalt transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-wrap items-center justify-between gap-x-6 px-4 py-3"
  >
    <a
      href="/"
      class="bg-cobalt px-3 py-2 text-sm leading-none font-black tracking-wide text-on-cobalt uppercase"
    >
      {SITE.title}
    </a>
    <button
      id="menu-btn"
      class="flex size-9 items-center justify-center md:hidden"
      aria-label="Open Menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <IconX id="close-icon" class="hidden" />
      <IconMenuDeep id="menu-icon" />
    </button>
    <nav
      id="nav-menu"
      class="hidden w-full flex-col gap-4 pt-4 pb-2 md:flex md:w-auto md:flex-row md:items-center md:gap-6 md:p-0"
    >
      <ul
        class="cw-ui flex flex-col tracking-wider uppercase md:flex-row md:items-center md:gap-5"
      >
        {
          navItems.map(item => (
            <li class="border-b border-line md:border-0">
              <a
                href={item.href}
                class:list={[
                  "block py-3 hover:text-cobalt md:py-1",
                  { "active-nav": !item.external && isActive(item.href) },
                ]}
                aria-current={
                  !item.external && isActive(item.href) ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="flex items-center gap-1 md:border-l md:border-line md:pl-4">
        <li>
          <a
            href="/rss.xml"
            target="_blank"
            class="flex size-9 items-center justify-center text-ink-muted hover:text-cobalt"
            aria-label="rss feed"
            title="RSS Feed"
          >
            <IconRss class="size-5" />
          </a>
        </li>
        <li>
          <a
            href="/terminal"
            class:list={[
              "flex size-9 items-center justify-center hover:text-cobalt",
              isActive("/terminal") ? "text-cobalt" : "text-ink-muted",
            ]}
            aria-label="terminal"
            title="Terminal"
          >
            <IconTerminal class="size-5" />
          </a>
        </li>
        <li>
          <button
            data-search-trigger
            class="flex size-9 items-center justify-center text-ink-muted hover:text-cobalt"
            aria-label="Search"
            title="Search (Ctrl+K / ⌘K)"
          >
            <IconSearch class="size-5" />
          </button>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                class="relative block size-9 text-ink-muted hover:text-cobalt hover:[&>svg]:stroke-current"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] size-5 -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menu = document.querySelector("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menu || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menu.classList.toggle("hidden");
      menu.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>

<SearchModal />
