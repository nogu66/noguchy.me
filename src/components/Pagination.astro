---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

export interface Props {
  page: Page<CollectionEntry<"blog"> | CollectionEntry<"news">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="cw-ui mx-auto mt-auto mb-16 flex w-full max-w-app items-center justify-center gap-4 px-4"
      aria-label="Pagination"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class="cw-btn select-none"
        ariaLabel="Previous"
      >
        <IconArrowLeft class="inline-block size-3 rtl:rotate-180" />
        Prev
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class="cw-btn select-none"
        ariaLabel="Next"
      >
        Next
        <IconArrowRight class="inline-block size-3 rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
