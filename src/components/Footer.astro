---
import Socials from "./Socials.astro";
import { SITE } from "@/config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/tags", label: "Tags" },
  { href: "/activities", label: "Activities" },
  { href: "/links", label: "Links" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer
  class:list={[
    "w-full max-w-none! bg-surface-soft px-0!",
    noMarginTop ? "mt-0" : "mt-auto",
  ]}
>
  <div
    class="mx-auto flex max-w-app flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <a
        href="/"
        class="site-logo flex w-fit items-center gap-2 text-xl leading-none font-black hover:text-cobalt"
      >
        <img
          src="/favicon.png"
          alt=""
          width="32"
          height="32"
          loading="lazy"
          class="size-8 rounded-full"
        />
        {SITE.title}
      </a>
      <p class="cw-ui mt-3 text-ink-muted">
        Copyright &#169; {currentYear} nogu. All rights reserved.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:items-end">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[13px] font-bold">
        {
          links.map(link => (
            <li>
              <a href={link.href} class="hover:text-cobalt">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Socials />
    </div>
  </div>
</footer>
