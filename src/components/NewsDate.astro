---
import { SITE } from "@/config";

interface Props {
  pubDatetime: Date;
  modDatetime?: Date | null;
  timezone?: string;
}
const { pubDatetime, modDatetime, timezone = SITE.timezone } = Astro.props;
const updated = modDatetime && modDatetime > pubDatetime;
const date = updated ? modDatetime : pubDatetime;
const label = new Intl.DateTimeFormat("ja-JP", {
  timeZone: timezone,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(date);
---

<time datetime={date.toISOString()} class="news-date"
  >{label}{updated && " 更新"}</time
>
