---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { getNewsPath } from "@/utils/getNewsPath";

export interface Props extends CollectionEntry<"news"> {
  variant?: "compact" | "default";
}

const { data, id, filePath, variant = "default" } = Astro.props;
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  thumbnail,
} = data;
---

<li
  class:list={[
    "group rounded-lg border border-border bg-background transition-all hover:border-accent/60 hover:shadow-sm",
    variant === "compact" ? "my-3 p-4" : "my-4 p-5",
  ]}
>
  <div class:list={["gap-4", { flex: thumbnail }]}>
    {
      thumbnail && (
        <a
          href={getNewsPath(id, filePath)}
          class:list={[
            "block aspect-video overflow-hidden rounded-md border border-[#d8e1ec] bg-[#f5f8fb]",
            {
              "w-28 shrink-0 sm:w-36": variant === "compact",
              "w-28 shrink-0 sm:w-40": variant === "default",
            },
          ]}
        >
          <img
            src={thumbnail}
            alt=""
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            loading={variant === "compact" ? "lazy" : "eager"}
          />
        </a>
      )
    }
    <div class="min-w-0">
      <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span
          class="text-xs font-semibold tracking-[0.18em] text-accent uppercase"
        >
          News
        </span>
        <Datetime {pubDatetime} {modDatetime} {timezone} />
      </div>
      <a
        href={getNewsPath(id, filePath)}
        class="inline-block text-lg font-semibold text-foreground-dark decoration-dashed underline-offset-4 hover:text-accent hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
      >
        {title}
      </a>
      <p class="mt-1 text-sm leading-relaxed text-foreground">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map(tag => (
              <span class="rounded-sm bg-light px-2 py-0.5 text-xs text-muted">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</li>
