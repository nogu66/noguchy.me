---
import type { CollectionEntry } from "astro:content";
import NewsDate from "./NewsDate.astro";
import { getNewsPath } from "@/utils/getNewsPath";

export interface Props extends CollectionEntry<"news"> {
  variant?: "compact" | "default";
  initiallyHidden?: boolean;
}

const {
  data,
  id,
  filePath,
  variant = "default",
  initiallyHidden = false,
} = Astro.props;
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  thumbnail,
} = data;
---

<li
  hidden={initiallyHidden}
  data-news-card
  data-initially-hidden={initiallyHidden}
  data-search-text={`${title} ${description} ${tags.join(" ")}`}
  data-topics={JSON.stringify(tags)}
  class:list={[
    "news-card group rounded-lg border border-border bg-background transition-all hover:border-accent/30 hover:shadow-sm",
    variant === "compact" ? "news-card-compact my-3" : "my-4",
  ]}
>
  <div class:list={["news-card-row", { "has-thumbnail": thumbnail }]}>
    {
      thumbnail && (
        <a
          href={getNewsPath(id, filePath)}
          aria-label={`記事を読む: ${title}`}
          class="news-card-thumbnail overflow-hidden rounded-md border border-border bg-light"
        >
          <img
            src={thumbnail}
            alt=""
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            loading={
              initiallyHidden || variant === "compact" ? "lazy" : "eager"
            }
            width="320"
            height="180"
          />
        </a>
      )
    }
    <div class="min-w-0">
      <div class="news-card-meta mb-2 flex items-center gap-x-3">
        <span
          class="news-card-label text-xs font-semibold tracking-[0.18em] text-accent uppercase"
        >
          {tags[0] ?? "News"}
        </span>
        <NewsDate {pubDatetime} {modDatetime} {timezone} />
      </div>
      <a
        href={getNewsPath(id, filePath)}
        title={title}
        class="news-card-title line-clamp-2 text-lg font-semibold text-foreground-dark decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
      >
        {title}
      </a>
      <p
        class="news-card-description mt-1 line-clamp-2 text-sm leading-relaxed text-foreground"
      >
        {description}
      </p>
      {
        tags.length > 0 && (
          <div class="news-card-tags mt-3 flex gap-1.5 overflow-hidden whitespace-nowrap">
            {tags.map(tag => (
              <a
                href={`/?tag=${encodeURIComponent(tag)}`}
                class="rounded-sm bg-light px-2 py-0.5 text-xs text-muted hover:text-accent"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</li>

<style>
  .news-card {
    container-type: inline-size;
    --thumbnail-width: 10rem;
    --card-padding: 1.25rem;
  }

  .news-card-compact {
    --thumbnail-width: 9rem;
    --card-padding: 1rem;
  }

  .news-card-row {
    display: grid;
    align-items: start;
    gap: 1rem;
    padding: var(--card-padding);
  }

  .has-thumbnail {
    grid-template-columns: var(--thumbnail-width) minmax(0, 1fr);
  }

  .news-card-thumbnail {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    align-self: start;
  }

  .news-card-meta {
    overflow: hidden;
    white-space: nowrap;
  }

  @container (max-width: 520px) {
    .news-card-row {
      --thumbnail-width: clamp(4rem, 24cqw, 6rem);
      gap: 0.75rem;
      padding: 0.75rem;
    }

    .news-card-label,
    .news-card-description,
    .news-card-tags {
      display: none;
    }

    .news-card-meta {
      margin-bottom: 0.25rem;
    }

    .news-card-meta :global(.news-card-date) {
      gap: 0.25rem;
    }

    .news-card-meta :global(svg) {
      display: none;
    }

    .news-card-meta :global(time),
    .news-card-meta :global(span) {
      font-size: 0.6875rem;
    }

    .news-card-title {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
</style>
