---
import { SOCIALS } from "@/constants";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class:list={["flex flex-wrap gap-2", { "justify-center": centered }]}>
  {
    SOCIALS.map(social => (
      <a
        href={social.href}
        class="flex size-9 items-center justify-center rounded-full border-2 border-cobalt text-cobalt hover:bg-cobalt hover:text-on-cobalt"
        title={social.linkTitle}
      >
        <social.icon class="size-4 fill-transparent stroke-current stroke-2" />
        <span class="sr-only">{social.linkTitle}</span>
      </a>
    ))
  }
</div>
