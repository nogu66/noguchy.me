---
import { getCollection, type CollectionEntry } from "astro:content";
import NewsDetails from "@/layouts/NewsDetails.astro";
import { getNewsPath } from "@/utils/getNewsPath";
import getSortedNews from "@/utils/getSortedNews";

interface Props {
  newsItem: CollectionEntry<"news">;
}
export async function getStaticPaths() {
  return getSortedNews(await getCollection("news")).map(newsItem => ({
    params: {
      slug: getNewsPath(newsItem.id, newsItem.filePath, false).replace(
        /^\//,
        ""
      ),
    },
    props: { newsItem },
  }));
}
const { newsItem } = Astro.props;
const news = getSortedNews(await getCollection("news"));
---

<NewsDetails {newsItem} {news} />
