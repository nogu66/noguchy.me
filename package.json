{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.0",
  "scripts": {
    "editor:news": "node scripts/news-editor-server.mjs",
    "editor:news:install": "node scripts/news-editor-install.mjs",
    "dev": "astro dev",
    "dev:news": "astro dev --config astro.news.config.ts",
    "build:news": "astro check --config astro.news.config.ts && astro build --config astro.news.config.ts",
    "preview:news": "wrangler dev --config wrangler.news.jsonc",
    "deploy:news": "pnpm run build:news && wrangler deploy --config wrangler.news.jsonc",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "new-post": "node scripts/create-post.js",
    "new-news": "node scripts/create-news.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.18.2",
    "astro-auto-import": "^0.5.1",
    "dayjs": "^1.11.19",
    "katex": "^0.17.0",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^17.0.5",
    "mermaid": "^11.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@pagefind/default-ui": "^1.4.0",
    "@shikijs/transformers": "^3.20.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.51.0",
    "dompurify": "^3.4.15",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "lucide-react": "^1.46.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "unified": "^11.0.5",
